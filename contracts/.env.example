# Wallet privada con BNB testnet (SOLO para deploy - NO subir a git)
PRIVATE_KEY=0x_your_deployer_private_key_here

# API key de BscScan para verificación (opcional pero recomendado)
# Consíguela gratis en https://bscscan.com/myapikey
BSCSCAN_API_KEY=your_bscscan_api_key

# Wallet receptora de comisiones (0.50% por defecto)
FEE_WALLET=0x60e655Fe39Bc7D17661f226bB44Dcc681cc4e05e

# Tesorería del launchpad (cobros fuera de la curva: Impulso, campañas, advanced fee)
TREASURY_WALLET=0x60e655Fe39Bc7D17661f226bB44Dcc681cc4e05e

# Sólo mainnet: pon true si intencionalmente el feeWallet es el deployer/owner
ALLOW_OWNER_FEE_WALLET=false

# PancakeSwap V2 Router en BSC Testnet
PANCAKE_ROUTER=0xD99D1c33F9fC3444f8101754aBC46c52416550D1
